import argparse
import json
from pathlib import Path


def media(a, b):
    return (a + b) / 2


def promedio_ponderado(valores):
    """
    valores:
    [
        (valor, peso),
        ...
    ]
    """

    validos = [
        (valor, peso)
        for valor, peso in valores
        if valor is not None
    ]

    if not validos:
        return None

    suma_pesos = sum(
        peso
        for _, peso in validos
    )

    if suma_pesos == 0:
        return None

    return sum(
        valor * peso
        for valor, peso in validos
    ) / suma_pesos


def resumen_xg(partidos, n):
    muestra = [
        p
        for p in partidos[:n]
        if (
            p.get("xg_disponible")
            and p.get("xgf") is not None
            and p.get("xga") is not None
        )
    ]

    if not muestra:
        return {
            "n": 0,
            "xgf": None,
            "xga": None,
        }

    return {
        "n": len(muestra),
        "xgf": sum(
            p["xgf"]
            for p in muestra
        ) / len(muestra),
        "xga": sum(
            p["xga"]
            for p in muestra
        ) / len(muestra),
    }


def cruzar(
    ataque_local,
    defensa_visitante,
    ataque_visitante,
    defensa_local,
):
    return {
        "local": media(
            ataque_local,
            defensa_visitante,
        ),
        "visitante": media(
            ataque_visitante,
            defensa_local,
        ),
    }


def agregar_total(metodo):
    metodo["total"] = (
        metodo["local"]
        + metodo["visitante"]
    )

    return metodo


def main():
    parser = argparse.ArgumentParser()

    parser.add_argument(
        "--match-id",
        required=True,
    )

    args = parser.parse_args()

    carpeta = (
        Path("data")
        / "matches"
        / args.match_id
    )

    ruta_enriched = (
        carpeta
        / "enriched.json"
    )

    ruta_xg = (
        carpeta
        / "xg_history.json"
    )

    if not ruta_enriched.exists():
        raise SystemExit(
            f"No existe: {ruta_enriched}"
        )

    if not ruta_xg.exists():
        raise SystemExit(
            f"No existe: {ruta_xg}"
        )

    with ruta_enriched.open(
        encoding="utf-8"
    ) as f:
        enriched = json.load(f)

    with ruta_xg.open(
        encoding="utf-8"
    ) as f:
        xg = json.load(f)

    obs = enriched[
        "datos_observados"
    ]

    local = obs["local"]
    visitante = obs["visitante"]
    temporada = obs["temporada"]

    nombre_local = local["equipo"]
    nombre_visitante = visitante[
        "equipo"
    ]

    xg_local_l5 = resumen_xg(
        xg["local"]["partidos"],
        5,
    )

    xg_local_l10 = resumen_xg(
        xg["local"]["partidos"],
        10,
    )

    xg_visitante_l5 = resumen_xg(
        xg["visitante"]["partidos"],
        5,
    )

    xg_visitante_l10 = resumen_xg(
        xg["visitante"]["partidos"],
        10,
    )

    metodos = {}

    # ========================================
    # A. Goles reales L5
    # ========================================

    metodos["A_goles_L5"] = agregar_total(
        cruzar(
            local["l5"]["promedio_gf"],
            visitante["l5"]["promedio_gc"],
            visitante["l5"]["promedio_gf"],
            local["l5"]["promedio_gc"],
        )
    )

    # ========================================
    # B. Goles reales L10
    # ========================================

    metodos["B_goles_L10"] = agregar_total(
        cruzar(
            local["l10"]["promedio_gf"],
            visitante["l10"]["promedio_gc"],
            visitante["l10"]["promedio_gf"],
            local["l10"]["promedio_gc"],
        )
    )

    # ========================================
    # C. Goles reales L20
    # ========================================

    metodos["C_goles_L20"] = agregar_total(
        cruzar(
            local["l20"]["promedio_gf"],
            visitante["l20"]["promedio_gc"],
            visitante["l20"]["promedio_gf"],
            local["l20"]["promedio_gc"],
        )
    )

    # ========================================
    # D. xG L5
    # ========================================

    if (
        xg_local_l5["xgf"] is not None
        and xg_visitante_l5["xga"] is not None
        and xg_visitante_l5["xgf"] is not None
        and xg_local_l5["xga"] is not None
    ):
        metodos["D_xG_L5"] = agregar_total(
            cruzar(
                xg_local_l5["xgf"],
                xg_visitante_l5["xga"],
                xg_visitante_l5["xgf"],
                xg_local_l5["xga"],
            )
        )

    # ========================================
    # E. xG L10
    # ========================================

    if (
        xg_local_l10["xgf"] is not None
        and xg_visitante_l10["xga"] is not None
        and xg_visitante_l10["xgf"] is not None
        and xg_local_l10["xga"] is not None
    ):
        metodos["E_xG_L10"] = agregar_total(
            cruzar(
                xg_local_l10["xgf"],
                xg_visitante_l10["xga"],
                xg_visitante_l10["xgf"],
                xg_local_l10["xga"],
            )
        )

    # ========================================
    # F. Condición casa / visitante
    # ========================================

    metodos[
        "F_casa_visitante"
    ] = agregar_total(
        cruzar(
            local["como_local"][
                "promedio_gf"
            ],
            visitante[
                "como_visitante"
            ]["promedio_gc"],
            visitante[
                "como_visitante"
            ]["promedio_gf"],
            local["como_local"][
                "promedio_gc"
            ],
        )
    )

    # ========================================
    # G. Temporada
    # ========================================

    if (
        temporada.get("local")
        and temporada.get("visitante")
    ):
        metodos[
            "G_temporada"
        ] = agregar_total(
            cruzar(
                temporada["local"][
                    "promedio_gf"
                ],
                temporada["visitante"][
                    "promedio_gc"
                ],
                temporada["visitante"][
                    "promedio_gf"
                ],
                temporada["local"][
                    "promedio_gc"
                ],
            )
        )

    # ========================================
    # H. Forma goles:
    #
    # L5  25%
    # L10 45%
    # L20 30%
    #
    # L10 es el centro.
    # L5 aporta recencia sin dominar.
    # L20 aporta estabilidad.
    # ========================================

    forma_goles_local_ataque = (
        promedio_ponderado(
            [
                (
                    local["l5"][
                        "promedio_gf"
                    ],
                    0.25,
                ),
                (
                    local["l10"][
                        "promedio_gf"
                    ],
                    0.45,
                ),
                (
                    local["l20"][
                        "promedio_gf"
                    ],
                    0.30,
                ),
            ]
        )
    )

    forma_goles_local_defensa = (
        promedio_ponderado(
            [
                (
                    local["l5"][
                        "promedio_gc"
                    ],
                    0.25,
                ),
                (
                    local["l10"][
                        "promedio_gc"
                    ],
                    0.45,
                ),
                (
                    local["l20"][
                        "promedio_gc"
                    ],
                    0.30,
                ),
            ]
        )
    )

    forma_goles_visitante_ataque = (
        promedio_ponderado(
            [
                (
                    visitante["l5"][
                        "promedio_gf"
                    ],
                    0.25,
                ),
                (
                    visitante["l10"][
                        "promedio_gf"
                    ],
                    0.45,
                ),
                (
                    visitante["l20"][
                        "promedio_gf"
                    ],
                    0.30,
                ),
            ]
        )
    )

    forma_goles_visitante_defensa = (
        promedio_ponderado(
            [
                (
                    visitante["l5"][
                        "promedio_gc"
                    ],
                    0.25,
                ),
                (
                    visitante["l10"][
                        "promedio_gc"
                    ],
                    0.45,
                ),
                (
                    visitante["l20"][
                        "promedio_gc"
                    ],
                    0.30,
                ),
            ]
        )
    )

    metodos[
        "H_forma_goles_5_10_20"
    ] = agregar_total(
        cruzar(
            forma_goles_local_ataque,
            forma_goles_visitante_defensa,
            forma_goles_visitante_ataque,
            forma_goles_local_defensa,
        )
    )

    # ========================================
    # I. Forma xG:
    #
    # L5  35%
    # L10 65%
    #
    # Sólo tenemos xG hasta L10.
    # ========================================

    forma_xg_local_ataque = (
        promedio_ponderado(
            [
                (
                    xg_local_l5["xgf"],
                    0.35,
                ),
                (
                    xg_local_l10["xgf"],
                    0.65,
                ),
            ]
        )
    )

    forma_xg_local_defensa = (
        promedio_ponderado(
            [
                (
                    xg_local_l5["xga"],
                    0.35,
                ),
                (
                    xg_local_l10["xga"],
                    0.65,
                ),
            ]
        )
    )

    forma_xg_visitante_ataque = (
        promedio_ponderado(
            [
                (
                    xg_visitante_l5["xgf"],
                    0.35,
                ),
                (
                    xg_visitante_l10["xgf"],
                    0.65,
                ),
            ]
        )
    )

    forma_xg_visitante_defensa = (
        promedio_ponderado(
            [
                (
                    xg_visitante_l5["xga"],
                    0.35,
                ),
                (
                    xg_visitante_l10["xga"],
                    0.65,
                ),
            ]
        )
    )

    if all(
        valor is not None
        for valor in (
            forma_xg_local_ataque,
            forma_xg_local_defensa,
            forma_xg_visitante_ataque,
            forma_xg_visitante_defensa,
        )
    ):
        metodos[
            "I_forma_xG_5_10"
        ] = agregar_total(
            cruzar(
                forma_xg_local_ataque,
                forma_xg_visitante_defensa,
                forma_xg_visitante_ataque,
                forma_xg_local_defensa,
            )
        )

    # ========================================
    # J. Híbrido experimental.
    #
    # NO es el modelo definitivo.
    #
    # 45% forma xG
    # 25% forma goles
    # 20% casa/visitante
    # 10% temporada
    # ========================================

    componentes_hibrido = [
        (
            "I_forma_xG_5_10",
            0.45,
        ),
        (
            "H_forma_goles_5_10_20",
            0.25,
        ),
        (
            "F_casa_visitante",
            0.20,
        ),
        (
            "G_temporada",
            0.10,
        ),
    ]

    hibrido_local = (
        promedio_ponderado(
            [
                (
                    metodos[nombre][
                        "local"
                    ],
                    peso,
                )
                for nombre, peso
                in componentes_hibrido
                if nombre in metodos
            ]
        )
    )

    hibrido_visitante = (
        promedio_ponderado(
            [
                (
                    metodos[nombre][
                        "visitante"
                    ],
                    peso,
                )
                for nombre, peso
                in componentes_hibrido
                if nombre in metodos
            ]
        )
    )

    metodos[
        "J_hibrido_experimental"
    ] = agregar_total(
        {
            "local": hibrido_local,
            "visitante": (
                hibrido_visitante
            ),
        }
    )

    print("=" * 86)
    print("COMPARADOR DE LAMBDA")
    print("=" * 86)

    print()
    print(
        nombre_local,
        "vs",
        nombre_visitante,
    )

    print()
    print(
        f"{'METODO':<30}"
        f"{nombre_local[:15]:>17}"
        f"{nombre_visitante[:15]:>17}"
        f"{'TOTAL':>12}"
    )

    print("-" * 76)

    for nombre, valores in (
        metodos.items()
    ):
        print(
            f"{nombre:<30}"
            f"{valores['local']:>17.3f}"
            f"{valores['visitante']:>17.3f}"
            f"{valores['total']:>12.3f}"
        )

    print()
    print("=" * 86)
    print("DATOS xG UTILIZADOS")
    print("=" * 86)

    print()
    print(nombre_local)

    print(
        "L5 :",
        xg_local_l5,
    )

    print(
        "L10:",
        xg_local_l10,
    )

    print()
    print(nombre_visitante)

    print(
        "L5 :",
        xg_visitante_l5,
    )

    print(
        "L10:",
        xg_visitante_l10,
    )

    print()
    print("=" * 86)
    print("IMPORTANTE")
    print("=" * 86)

    print(
        "J_hibrido_experimental NO es "
        "todavía el modelo final."
    )

    print(
        "Los pesos existen sólo para "
        "comparar una primera combinación."
    )


if __name__ == "__main__":
    main()
