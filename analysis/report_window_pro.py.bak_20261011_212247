              <td>{esc(row_value(r, STANDING_ALIASES['pg']))}</td>
              <td>{esc(row_value(r, STANDING_ALIASES['pe']))}</td>
              <td>{esc(row_value(r, STANDING_ALIASES['pp']))}</td>
