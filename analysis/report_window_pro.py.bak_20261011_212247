def cargar(path):
    try:
        return json.loads(
            path.read_text(encoding="utf-8")
        )
    except Exception:
        return None


def esc(x):
    return html.escape(str(x if x is not None else ""))


def num(x):
    try:
        v = float(x)
        if math.isfinite(v):
            return v
    except Exception:
        pass
    return None


def under(x):
    """
    Complemento exacto de una línea Over de medio gol.

    +1.5 -> -1.5
    +2.5 -> -2.5
    +3.5 -> -3.5
    """
    v = prob(x)

    if v is None:
        return None

    return 1.0 - v


def dec(x, n=2):
    v = num(x)
    if v is None:
        return "N/D"
    return f"{v:.{n}f}"


def prob(x):
    if x is None:
        return None

    if isinstance(x, str):
        s = x.strip()

        try:
            if s.endswith("%"):
                return float(s[:-1]) / 100
            x = float(s)
        except Exception:
            return None

    v = num(x)

    if v is None:
        return None

    if 1 < v <= 100:
        v /= 100

    return v


def pct(x):
    v = prob(x)

    if v is None:
        return "N/D"

    return f"{v:.1%}"


def valor(d, *claves):
    if not isinstance(d, dict):
        return None

    for k in claves:
        if d.get(k) is not None:
            return d.get(k)

    return None


def normalizar(s):
    s = str(s or "").strip().casefold()

    s = "".join(
        c
        for c in unicodedata.normalize(
            "NFKD",
            s,
        )
        if not unicodedata.combining(c)
    )

    s = re.sub(
        r"\s+\([^)]*\)$",
        "",
        s,
    )

    s = re.sub(
        r"[^a-z0-9]+",
        " ",
        s,
    )

    return " ".join(s.split())


def norm_key(s):
    return normalizar(
        str(s).replace("_", " ")
    ).replace(" ", "")


def mid_partido(p):
    return (
        p.get("match_id")
        or p.get("id")
