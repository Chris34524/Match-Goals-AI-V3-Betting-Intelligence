def xg_window(d):
    if not isinstance(d, dict):
        return None

    n = valor(
        d,
        "n",
        "partidos",
        "disponibles",
        "count",
    )

    xgf = valor(
        d,
        "xgf",
        "xGF",
        "xg_favor",
    )

    xga = valor(
        d,
        "xga",
        "xGA",
        "xg_contra",
    )

    if (
        num(xgf) is None
        and num(xga) is None
    ):
        return None

    return {
        "n": n,
        "xgf": num(xgf),
        "xga": num(xga),
    }


def buscar_xg_bloques(
    obj,
    path="",
    salida=None,
):
    if salida is None:
        salida = []

    if isinstance(obj, dict):
        keys = {
            norm_key(k): k
            for k in obj
        }

        l5_key = keys.get("l5")
        l10_key = keys.get("l10")

        if l5_key or l10_key:
            l5 = (
                xg_window(
                    obj.get(l5_key)
                )
                if l5_key
                else None
            )

            l10 = (
                xg_window(
                    obj.get(l10_key)
                )
                if l10_key
                else None
            )

            if l5 or l10:
                nombre = (
                    valor(
                        obj,
                        "equipo",
                        "team",
                        "nombre",
                    )
                    or path.split(".")[-1]
                    or "Equipo"
                )

                salida.append(
                    {
                        "nombre": nombre,
                        "l5": l5,
                        "l10": l10,
                    }
                )

        for k, v in obj.items():
            if isinstance(
                v,
                (dict, list),
            ):
                buscar_xg_bloques(
                    v,
                    (
                        f"{path}.{k}"
                        if path
                        else str(k)
                    ),
                    salida,
                )

    elif isinstance(obj, list):
        for i, v in enumerate(obj):
            if isinstance(
                v,
                (dict, list),
            ):
                buscar_xg_bloques(
                    v,
                    f"{path}[{i}]",
                    salida,
                )

    return salida


def render_xg(data):
    bloques = buscar_xg_bloques(
        data
    )

    unicos = []
    vistos = set()

    for b in bloques:
        clave = (
            normalizar(b["nombre"]),
            str(b["l5"]),
            str(b["l10"]),
        )

        if clave in vistos:
            continue

        vistos.add(clave)
        unicos.append(b)

    if not unicos:
        return """
        <div class="empty">
          xG no disponible o sin cobertura
          suficiente para este encuentro.
        </div>
        """

    filas = []

    for b in unicos[:4]:
        for etiqueta in (
            "l5",
            "l10",
        ):
            w = b.get(etiqueta)

            if not w:
                continue

            filas.append(
                f"""
                <tr>
                  <td>{esc(b['nombre'])}</td>
                  <td>{etiqueta.upper()}</td>
                  <td>{esc(w.get('n'))}</td>
                  <td>{dec(w.get('xgf'), 3)}</td>
                  <td>{dec(w.get('xga'), 3)}</td>
                </tr>
                """
            )

    return f"""
    <table class="mini-table">
      <thead>
        <tr>
          <th>Equipo</th>
          <th>Muestra</th>
          <th>xG disp.</th>
          <th>xGF/PJ</th>
          <th>xGA/PJ</th>
        </tr>
      </thead>
      <tbody>
        {''.join(filas)}
      </tbody>
    </table>
    """


