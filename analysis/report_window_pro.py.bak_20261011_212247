def seccion_history(
    history,
    tipo,
    equipo=None,
):
    if not isinstance(history, dict):
        return None

    secciones = history.get(
        "secciones",
        [],
    )

    for s in secciones:
        if s.get("tipo_estimado") == tipo:
            return s

    if equipo:
        ne = normalizar(equipo)

        candidatos = []

        for s in secciones:
            if s.get("tipo_estimado") == "h2h":
                continue

            titulo = str(
                s.get("titulo") or ""
            )

            titulo = re.sub(
                r"^ÚLTIMOS PARTIDOS:\s*",
                "",
                titulo,
                flags=re.I,
            )

            if normalizar(titulo) == ne:
                candidatos.append(s)

        if len(candidatos) == 1:
            return candidatos[0]

    return None


def goles_fila(f):
    gl = valor(
        f,
        "goles_local",
        "gol_local",
        "home_score",
        "score_home",
    )

    gv = valor(
        f,
        "goles_visitante",
        "gol_visitante",
        "away_score",
        "score_away",
    )

    gl = num(gl)
    gv = num(gv)

    if gl is not None and gv is not None:
        return int(gl), int(gv)

    resultado = str(
        valor(
            f,
            "resultado",
            "score",
            "marcador",
        )
        or ""
    )

    m = re.search(
        r"(\d+)\s*[-:]\s*(\d+)",
        resultado,
    )

    if m:
        return (
            int(m.group(1)),
            int(m.group(2)),
        )

    return None, None


def datos_fila(f):
    return {
        "fecha": valor(
            f,
            "fecha",
            "date",
        ),
        "competicion": valor(
            f,
            "competicion",
            "liga",
            "tournament",
        ),
        "local": valor(
            f,
            "local",
            "equipo_local",
            "home",
        ),
        "visitante": valor(
            f,
            "visitante",
            "equipo_visitante",
            "away",
        ),
    }


def perspectiva(f, equipo):
    d = datos_fila(f)

    gl, gv = goles_fila(f)

    if gl is None or gv is None:
        return None

    ne = normalizar(equipo)

    nl = normalizar(d["local"])
    nv = normalizar(d["visitante"])

    if ne == nl:
        gf = gl
        ga = gv
        sede = "L"

    elif ne == nv:
        gf = gv
        ga = gl
        sede = "V"

    else:
        return None

    if gf > ga:
        res = "G"
    elif gf == ga:
        res = "E"
    else:
        res = "P"

    return {
        "gf": gf,
        "ga": ga,
        "tg": gf + ga,
        "btts": int(
            gf > 0 and ga > 0
        ),
        "o25": int(
            gf + ga >= 3
        ),
        "resultado": res,
        "sede": sede,
    }


def resumen_forma(
    filas,
    equipo,
    limite,
    sede=None,
):
    validos = []

    for f in filas:
        x = perspectiva(
            f,
            equipo,
        )

        if not x:
            continue

        if sede and x["sede"] != sede:
            continue

        validos.append(x)

        if len(validos) >= limite:
            break

    if not validos:
        return None

    n = len(validos)

    return {
        "n": n,
        "gf": sum(
            x["gf"]
            for x in validos
        ) / n,
        "ga": sum(
            x["ga"]
            for x in validos
        ) / n,
        "tg": sum(
            x["tg"]
            for x in validos
        ) / n,
        "o25": sum(
            x["o25"]
            for x in validos
        ) / n,
        "btts": sum(
            x["btts"]
            for x in validos
        ) / n,
        "g": sum(
            x["resultado"] == "G"
            for x in validos
        ),
        "e": sum(
            x["resultado"] == "E"
            for x in validos
        ),
        "p": sum(
            x["resultado"] == "P"
            for x in validos
        ),
    }


