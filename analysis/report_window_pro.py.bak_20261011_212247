def row_value(
    row,
    aliases,
):
    mapa = {
        norm_key(k): v
        for k, v in row.items()
    }

    for a in aliases:
        k = norm_key(a)

        if k in mapa:
            return mapa[k]

    return None


def caminar_listas(
    obj,
    path="",
):
    if isinstance(obj, dict):
        for k, v in obj.items():
            nuevo = (
                f"{path}.{k}"
                if path
                else str(k)
            )

            yield from caminar_listas(
                v,
                nuevo,
            )

    elif isinstance(obj, list):
        if (
            len(obj) >= 2
            and all(
                isinstance(x, dict)
                for x in obj
            )
        ):
            yield path, obj

        for i, v in enumerate(obj):
            if isinstance(
                v,
                (dict, list),
            ):
                yield from caminar_listas(
                    v,
                    f"{path}[{i}]",
                )


def mejor_tabla_standings(data):
    if not data:
        return None

    mejor = None
    mejor_score = -1

    for path, filas in caminar_listas(
        data
    ):
        if not filas:
            continue

        muestra = filas[:5]

        score = 0

        for campo in (
            "equipo",
            "pos",
            "pj",
            "pts",
            "gf",
            "gc",
        ):
            encontrados = sum(
                row_value(
                    r,
                    STANDING_ALIASES[
                        campo
                    ],
                )
                is not None
                for r in muestra
            )

            if encontrados:
                score += 1

        if score > mejor_score:
            mejor_score = score
            mejor = (
                path,
                filas,
            )

    if mejor_score < 2:
        return None

    return mejor


def render_standings(
    data,
    local,
    visitante,
):
    mejor = mejor_tabla_standings(
        data
    )

    if not mejor:
        return """
