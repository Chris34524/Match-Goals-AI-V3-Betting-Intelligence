        cargar(
            carpeta / "history.json"
        )
        if carpeta
        else None
    )

    standings = (
        cargar(
            carpeta / "standings.json"
        )
        if carpeta
        else None
    )

    xg = (
        cargar(
            carpeta / "xg_history.json"
        )
        if carpeta
        else None
    )

    enriched = (
        cargar(
            carpeta / "enriched.json"
        )
        if carpeta
        else None
    )

    h2h = (
        cargar(
            carpeta / "h2h_analysis.json"
