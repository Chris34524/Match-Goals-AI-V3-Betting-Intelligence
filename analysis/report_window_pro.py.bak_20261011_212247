def main():
    if not SRC.exists():
        raise SystemExit(
            "No existe "
            "data/day_predictions_v2.json"
        )

    datos = cargar(SRC)

    if not datos:
        raise SystemExit(
            "No pude leer day_predictions_v2.json"
        )

    partidos = datos.get(
        "partidos",
        []
    )

    if not partidos:
        raise SystemExit(
            "No hay partidos analizados "
            "en la ventana."
        )

    # ----------------------------------------
    # Ranking resumen
    # ----------------------------------------

    resumen = []

    convencionales = 0
    fuera = 0
    fuertes_btts = 0

    for i, p in enumerate(
        partidos,
        1,
    ):
        local = nombre_local(p)
        visitante = nombre_visitante(p)

        lh = valor(
            p,
            "lambda_local",
            "lambda_home",
        )

        la = valor(
            p,
            "lambda_visitante",
            "lambda_away",
        )

        lt = valor(
            p,
            "lambda_total",
            "total_lambda",
        )

        p15 = valor(
            p,
            "+1.5",
            "over_1_5",
        )

        p25 = valor(
            p,
            "+2.5",
            "over_2_5",
        )

        p35 = valor(
            p,
            "+3.5",
            "over_3_5",
        )

        p45 = valor(
            p,
            "+4.5",
            "over_4_5",
        )

        btts = valor(
            p,
            "BTTS",
            "btts",
            "p_btts",
        )

        calidad = p.get(
            "calidad_datos",
            "N/D",
        )

        conf = p.get(
            "confianza_btts",
            "N/D",
        )

        if calidad == "FUERA_MODELO":
            fuera += 1
        else:
            convencionales += 1

        if conf == "FUERTE":
            fuertes_btts += 1

        hora = (
            p.get("hora")
            or ""
        )

        comp = (
            p.get("competicion")
            or p.get("liga")
            or ""
        )

        resumen.append(
            f"""
            <tr>
              <td>{i}</td>

              <td class="team-cell">
                <a href="#partido-{i}">
