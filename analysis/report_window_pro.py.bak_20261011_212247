          para este partido.
        </div>
        """

    _, filas = mejor

    nl = normalizar(local)
    nv = normalizar(visitante)

    rows = []

    for r in filas:
        equipo = row_value(
            r,
            STANDING_ALIASES["equipo"],
        )

        if equipo is None:
            continue

        ne = normalizar(equipo)

        cls = ""

        if ne == nl or ne == nv:
            cls = "standing-highlight"

        rows.append(
            f"""
