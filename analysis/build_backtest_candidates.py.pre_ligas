import argparse
import json
from collections import defaultdict
from pathlib import Path


ENTRADA = Path("data/partidos.json")
SALIDA = Path("data/backtest_candidates.json")


def argumentos():
    p = argparse.ArgumentParser()
    p.add_argument("--limit", type=int, default=20)
    return p.parse_args()


def terminado(p):
    gl = p.get("gol_local")
    gv = p.get("gol_visitante")

    if gl is None or gv is None:
        return False

    try:
        int(gl)
        int(gv)
        return True
    except (TypeError, ValueError):
        return False


def seleccionar_distribuidos(grupo, cantidad):
    if cantidad <= 0:
        return []

    if len(grupo) <= cantidad:
        return grupo[:]

    # Selección determinista repartida por toda
    # la lista, sin mirar el marcador.
    indices = []

    for i in range(cantidad):
        indice = int(
            i * len(grupo) / cantidad
        )

        indices.append(indice)

    return [
        grupo[i]
        for i in indices
    ]


def main():
    args = argumentos()

    with ENTRADA.open(encoding="utf-8") as f:
        datos = json.load(f)

    partidos = (
        datos.get("partidos", [])
        if isinstance(datos, dict)
        else datos
    )

    por_fecha = defaultdict(list)

    for p in partidos:
        if not terminado(p):
            continue

        mid = p.get("id")
        fecha = p.get("fecha")

        if not mid or not fecha:
            continue

        por_fecha[fecha].append(p)

    fechas = sorted(por_fecha)

    if not fechas:
        raise RuntimeError(
            "No hay partidos terminados elegibles."
        )

    base = args.limit // len(fechas)
    resto = args.limit % len(fechas)

    seleccion = []

    for posicion, fecha in enumerate(fechas):
        cantidad = base

        if posicion < resto:
            cantidad += 1

        elegidos = seleccionar_distribuidos(
            por_fecha[fecha],
            cantidad,
        )

        for p in elegidos:
            seleccion.append(
                {
                    "match_id": p["id"],
                    "fecha": p["fecha"],
                    "local": p.get("local"),
                    "visitante": p.get("visitante"),
                    "gol_local": int(
                        p["gol_local"]
                    ),
                    "gol_visitante": int(
                        p["gol_visitante"]
                    ),
                }
            )

    salida = {
        "objetivo": args.limit,
        "seleccionados": len(seleccion),
        "fechas_disponibles": fechas,
        "distribucion": {
            fecha: sum(
                1
                for p in seleccion
                if p["fecha"] == fecha
            )
            for fecha in fechas
        },
        "partidos": seleccion,
    }

    with SALIDA.open(
        "w",
        encoding="utf-8",
    ) as f:
        json.dump(
            salida,
            f,
            ensure_ascii=False,
            indent=2,
        )

    print(
        "Seleccionados:",
        len(seleccion),
    )

    print(
        "Distribución:",
        salida["distribucion"],
    )

    print()

    for i, p in enumerate(
        seleccion,
        start=1,
    ):
        print(
            f"{i:>2}. "
            f"{p['fecha']} | "
            f"{p['match_id']} | "
            f"{p['local']} - "
            f"{p['visitante']} | "
            f"{p['gol_local']}-"
            f"{p['gol_visitante']}"
        )

    print()
    print("Guardado:", SALIDA)


if __name__ == "__main__":
    main()
