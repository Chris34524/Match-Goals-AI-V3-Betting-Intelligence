import argparse
import json
from collections import defaultdict
from pathlib import Path


ENTRADA = Path("data/partidos.json")
SALIDA = Path("data/backtest_candidates.json")


def argumentos():
    p = argparse.ArgumentParser()
    p.add_argument("--limit", type=int, default=20)
    return p.parse_args()


def terminado(p):
    gl = p.get("gol_local")
    gv = p.get("gol_visitante")

    if gl is None or gv is None:
        return False

    try:
        int(gl)
        int(gv)
        return True
    except (TypeError, ValueError):
        return False


def main():
    args = argumentos()

    with ENTRADA.open(encoding="utf-8") as f:
        datos = json.load(f)

    partidos = (
        datos.get("partidos", [])
        if isinstance(datos, dict)
        else datos
    )

    por_fecha = defaultdict(list)

    for p in partidos:
        if not terminado(p):
            continue

        mid = p.get("id")
        fecha = p.get("fecha")

        if not mid or not fecha:
            continue

        por_fecha[fecha].append(p)

    fechas = sorted(por_fecha)

    if not fechas:
        raise RuntimeError(
            "No hay partidos terminados elegibles."
        )

    seleccion = []

    # Round-robin por fecha para evitar que el lote
    # quede concentrado sólo en un día.
    indice = 0

    while len(seleccion) < args.limit:
        agregado = False

        for fecha in fechas:
            grupo = por_fecha[fecha]

            if indice >= len(grupo):
                continue

            p = grupo[indice]

            seleccion.append({
                "match_id": p["id"],
                "fecha": p["fecha"],
                "local": p.get("local"),
                "visitante": p.get("visitante"),
                "gol_local": int(p["gol_local"]),
                "gol_visitante": int(
                    p["gol_visitante"]
                ),
            })

            agregado = True

            if len(seleccion) >= args.limit:
                break

        if not agregado:
            break

        indice += 1

    salida = {
        "objetivo": args.limit,
        "seleccionados": len(seleccion),
        "fechas_disponibles": fechas,
        "partidos": seleccion,
    }

    with SALIDA.open(
        "w",
        encoding="utf-8",
    ) as f:
        json.dump(
            salida,
            f,
            ensure_ascii=False,
            indent=2,
        )

    print(
        f"Seleccionados: {len(seleccion)}"
    )

    for i, p in enumerate(
        seleccion,
        start=1,
    ):
        print(
            f"{i:>2}. "
            f"{p['fecha']} | "
            f"{p['match_id']} | "
            f"{p['local']} - "
            f"{p['visitante']} | "
            f"{p['gol_local']}-"
            f"{p['gol_visitante']}"
        )

    print()
    print("Guardado:", SALIDA)


if __name__ == "__main__":
    main()
