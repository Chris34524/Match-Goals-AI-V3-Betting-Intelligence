import argparse
import shutil
import subprocess
import sys
from datetime import date, datetime, timedelta
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
DATA = ROOT / "data"

DAY = DATA / "day_predictions_v2.json"
SELECTED_DATA = DATA / "selected_predictions_v2.json"
REPORT_SOURCE = DATA / "report_window_pro.html"
REPORT_CURRENT = DATA / "Match_Goals_AI_Seleccion_Actual.html"


def ejecutar(modulo, args=None):
    cmd = [
        sys.executable,
        "-u",
        "-m",
        modulo,
    ]

    if args:
        cmd.extend(args)

    print()
    print("=" * 100)
    print("EJECUTANDO:")
    print(" ".join(cmd))
    print("=" * 100)

    r = subprocess.run(
        cmd,
        cwd=ROOT,
    )

    if r.returncode != 0:
        raise RuntimeError(
            f"{modulo} terminó con código "
            f"{r.returncode}"
        )


def resolver_fecha(valor):
    hoy = date.today()

    v = str(valor).strip().lower()

    if v in ("today", "hoy"):
        return hoy

    if v in (
        "tomorrow",
        "mañana",
        "manana",
    ):
        return hoy + timedelta(days=1)

    return datetime.strptime(
        v,
        "%Y-%m-%d",
    ).date()


def abrir_html(path):
    r = subprocess.run(
        [
            "wslpath",
            "-w",
            str(path),
        ],
        capture_output=True,
        text=True,
        check=True,
    )

    winfile = r.stdout.strip()

    subprocess.Popen(
        [
            "cmd.exe",
            "/C",
            "start",
            "",
            winfile,
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def main():
    parser = argparse.ArgumentParser(
        description=(
            "Selección + scrapeo + análisis + "
            "reporte profesional + apertura HTML"
        )
    )

    parser.add_argument(
        "--select",
        required=True,
        help='Ejemplo: "54,81,84,89"',
    )

    parser.add_argument(
        "--date",
        default="tomorrow",
        help=(
            "tomorrow, today o YYYY-MM-DD. "
            "Por defecto: tomorrow"
        ),
    )

    parser.add_argument(
        "--window",
        action="store_true",
        help=(
            "Selecciona desde la ventana ya "
            "analizada en vez de partidos.json."
        ),
    )

    parser.add_argument(
        "--refresh",
        action="store_true",
        help=(
            "Vuelve a scrapear los datos "
            "de los partidos seleccionados."
        ),
    )

    parser.add_argument(
        "--refresh-list",
        action="store_true",
        help=(
            "Actualiza partidos.json antes de "
            "seleccionar. Ojo: puede cambiar "
            "la numeración de la lista."
        ),
    )

    args = parser.parse_args()

    print()
    print("=" * 100)
    print("MATCH GOALS AI — PROCESO AUTOMÁTICO")
    print("=" * 100)

    # ========================================================
    # 1. SELECCIÓN + SCRAPEO + ANÁLISIS
    # ========================================================

    selector = []

    if args.window:
        selector.extend([
            "--source",
            "window",
        ])

        seleccion_file = (
            DATA
            / "selected_matches_window.json"
        )

        etiqueta = "window"

    else:
        fecha = resolver_fecha(
            args.date
        )

        selector.extend([
            "--source",
            "day",
            "--date",
            args.date,
        ])

        seleccion_file = (
            DATA
            / (
                "selected_matches_"
                + fecha.isoformat()
                + ".json"
            )
        )

        etiqueta = fecha.isoformat()

    selector.extend([
        "--select",
        args.select,
        "--run",
    ])

    if args.refresh:
        selector.append(
            "--refresh-data"
        )

    if (
        args.refresh_list
        and not args.window
    ):
        selector.append(
            "--refresh-list"
        )

    ejecutar(
        "analysis.select_day_matches",
        selector,
    )

    if not seleccion_file.exists():
        raise RuntimeError(
            "No apareció el archivo de "
            f"selección: {seleccion_file}"
        )

    # ========================================================
    # 2. CONSTRUIR DATASET DEL REPORTE
    # ========================================================

    ejecutar(
        "analysis.build_selected_report_data",
        [
            "--file",
            str(
                seleccion_file.relative_to(
                    ROOT
                )
            ),
            "--output",
            "data/selected_predictions_v2.json",
        ],
    )

    if not SELECTED_DATA.exists():
        raise RuntimeError(
            "No se generó "
            "selected_predictions_v2.json"
        )

    # ========================================================
    # 2B. CONGELAR PREDICCIÓN PREMATCH
    # ========================================================

    ejecutar(
        "analysis.prediction_snapshot",
        [
            "--input",
            "data/selected_predictions_v2.json",
            "--date",
            etiqueta,
        ],
    )

    # ========================================================
    # 3. GENERAR REPORTE PROFESIONAL
    # ========================================================

    backup = (
        DATA
        / ".day_predictions_v2.oneclick.bak"
    )

    habia_day = DAY.exists()

    if habia_day:
        shutil.copy2(
            DAY,
            backup,
        )

    try:
        shutil.copy2(
            SELECTED_DATA,
            DAY,
        )

        ejecutar(
            "analysis.report_window_pro"
        )

        ejecutar(
            "analysis.inject_prediction_panel",
            [
                "--html",
                "data/report_window_pro.html",
                "--data",
                "data/selected_predictions_v2.json",
            ],
        )

        if not REPORT_SOURCE.exists():
            raise RuntimeError(
                "No se generó "
                "report_window_pro.html"
            )

        shutil.copy2(
            REPORT_SOURCE,
            REPORT_CURRENT,
        )

        # También guardamos copia por fecha.
        archive = (
            DATA
            / (
                "Match_Goals_AI_Seleccion_"
                + etiqueta
                + ".html"
            )
        )

        shutil.copy2(
            REPORT_SOURCE,
            archive,
        )

    finally:
        # Restauramos la ventana normal para no
        # contaminar futuros reportes.
        if habia_day and backup.exists():
            shutil.copy2(
                backup,
                DAY,
            )

            backup.unlink(
                missing_ok=True
            )

        elif not habia_day:
            DAY.unlink(
                missing_ok=True
            )

    # ========================================================
    # 4. ABRIR AUTOMÁTICAMENTE
    # ========================================================

    print()
    print("=" * 100)
    print("PROCESO COMPLETADO")
    print("=" * 100)

    print(
        "Selección:",
        args.select,
    )

    print(
        "Reporte:",
        REPORT_CURRENT,
    )

    print()
    print(
        "Abriendo reporte en Windows..."
    )

    abrir_html(
        REPORT_CURRENT
    )


if __name__ == "__main__":
    main()
